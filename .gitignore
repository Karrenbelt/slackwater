# Everything hidden is ignored, then re-included deliberately.
**/.*

!.cargo
!.config
!.envrc
!.github
!.gitignore
!.gitmodules
!**/.gitkeep

# Secret-shaped files outside the hidden-file rule
*.env
*.key
*.pem

# Chain readings: the raw rows that cannot be fetched again are kept, with
# their manifest; derived output and re-fetchable receipt logs are not.
/data/*
!/data/README.md
!/data/MANIFEST.jsonl
!/data/raw/
/data/raw/fill-tx-logs.jsonl

# Rust
**/target/

# Foundry; lib/ is reconstituted by `just deps`
/smart_contracts/lib/
/smart_contracts/out/
/smart_contracts/cache/
/smart_contracts/broadcast/
